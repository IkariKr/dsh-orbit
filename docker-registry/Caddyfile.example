# v0.5 Registry gateway example (RFC-0012 D2; supersedes the v0.3 layout).
#
# The browser ingress ends HERE. The machine ingress reaches the Hub ONLY
# through the exact RFC-0012 D2 allowlist below; every other machine path,
# including /api/v1/enroll, still never ends here.
# Enforced at the gateway:
#   1. an authentication GATE runs first for browser surfaces (basic_auth
#      below);
#   2. only after it passes are the internal assertion + principal
#      injected;
#   3. client-supplied assertion/principal-shaped headers are stripped
#      BEFORE injection and never trusted;
#   4. the browser's OWN Cookie / Origin / Sec-Fetch-Site pass through
#      untouched — the hub's RFC-0007 trust checks depend on them;
#   5. machine traffic (pair / heartbeat / report-upload /
#      credential-rotate / reenroll / reverse control+channel) is admitted
#      ONLY on the deployment-designated Hub authority, with no
#      authentication gate, no injected principal, and browser cookies /
#      gateway assertion headers stripped before the Hub machine handler;
#   6. node route authorities (n-*.dsh.example.local) deny exactly the
#      Orbit machine paths (RFC-0012 D2 Host-scoped admission); DSH
#      application paths keep routing normally.

# The gateway shares the Hub container's network namespace
# (network_mode: service:registry-hub in compose), so it reaches the hub's
# loopback listener exactly as documented — the frozen loopback-only
# listener policy is never relaxed.
{
    # replace with your domain and certificate management
    email admin@example.invalid
}

registration.example.invalid {
    # RFC-0012 D2 machine allowlist FIRST (matchers are evaluated in
    # order): exact paths only, POST for the RFC-0006 routes, GET
    # (WebSocket upgrade) for the reverse surfaces. No basic_auth gate and
    # no injected principal: machine requests authenticate with their own
    # RFC-0006 credentials (or the pairing token). Browser cookies,
    # Origin, and gateway assertion headers are stripped so machine
    # traffic never inherits a browser session.
    @machinePost {
        method POST
        path /api/v1/pair /api/v1/heartbeat /api/v1/report-upload /api/v1/credential-rotate /api/v1/reenroll
    }
    handle @machinePost {
        reverse_proxy 127.0.0.1:5445 {
            header_up -Cookie
            header_up -Origin
            header_up -X-DSH-Authenticated-Proxy
            header_up -X-DSH-Operator-Id
        }
    }

    @machineUpgrade {
        method GET
        path /api/v1/reverse/control /api/v1/reverse/channel
    }
    handle @machineUpgrade {
        reverse_proxy 127.0.0.1:5445 {
            header_up -Cookie
            header_up -Origin
            header_up -X-DSH-Authenticated-Proxy
            header_up -X-DSH-Operator-Id
        }
    }

    # Known machine paths with the wrong method fail closed at the
    # gateway (RFC-0012 D2: wrong method is 405 before Hub logic).
    @machineWrongMethod {
        not method POST
        path /api/v1/pair /api/v1/heartbeat /api/v1/report-upload /api/v1/credential-rotate /api/v1/reenroll
    }
    handle @machineWrongMethod {
        respond 405
    }

    @machineUpgradeWrongMethod {
        not method GET
        path /api/v1/reverse/control /api/v1/reverse/channel
    }
    handle @machineUpgradeWrongMethod {
        respond 405
    }

    # Every other machine path — including /api/v1/enroll — is refused.
    @machineDenied path /api/v1/*
    handle @machineDenied {
        respond 403
    }

    # The UI shell (no session needed; contains no data).
    @assets path / /index.html /app.mjs /view-model.mjs /styles.css
    handle @assets {
        basic_auth {
            operator $2a$10$REPLACE_WITH_BCRYPT_HASH
        }
        reverse_proxy 127.0.0.1:5445 {
            header_up X-DSH-Authenticated-Proxy {$DSH_ORBIT_HUB_GATEWAY_SECRET}
            header_up X-DSH-Operator-Id {$DSH_ORBIT_HUB_OPERATOR_PRINCIPAL}
        }
    }

    # Everything else (the /hub/* management surface): authentication
    # GATE first, then strip + inject, browser headers untouched.
    handle {
        basic_auth {
            operator $2a$10$REPLACE_WITH_BCRYPT_HASH
        }
        reverse_proxy 127.0.0.1:5445 {
            header_up X-DSH-Authenticated-Proxy {$DSH_ORBIT_HUB_GATEWAY_SECRET}
            header_up X-DSH-Operator-Id {$DSH_ORBIT_HUB_OPERATOR_PRINCIPAL}
            # Cookie / Origin / Sec-Fetch-Site pass through untouched.
        }
    }
}

# Generate the bcrypt hash with:
#   caddy hash-password --plaintext '<gateway operator password>'

# Wildcard public route authority and selector apex (RFC-0010, Stage 3).
# Terminates public TLS for *.dsh.example.local and the selector apex dsh.example.local.
# Executes the outer gateway authentication GATE first (basic_auth below), consumes/strips
# gateway-owned authentication credentials, preserves canonical Host, and reverse proxies
# to the Hub loopback listener. The Hub routes opaquely based on deterministic Host:
# - dsh.example.local -> Selector return landing
# - n-<nodeId>.dsh.example.local -> Deterministic node route proxying to downstream DSH
# - invalid wildcard subdomains -> 404 route-not-found (fail closed before private APIs)
# - ANY Orbit machine path -> 404: machine paths are admitted only on the
#   deployment-designated Hub authority (RFC-0012 D2); DSH application
#   paths keep routing.
dsh.example.local, *.dsh.example.local {
    @machineApi path /api/v1/enroll /api/v1/pair /api/v1/heartbeat /api/v1/report-upload /api/v1/credential-rotate /api/v1/reenroll /api/v1/reverse/control /api/v1/reverse/channel
    handle @machineApi {
        respond 404
    }

    basic_auth {
        operator $2a$10$REPLACE_WITH_BCRYPT_HASH
    }
    reverse_proxy 127.0.0.1:5445 {
        header_up Host {host}
        header_up -Authorization
        header_up -X-Gateway-Auth
    }
}
