# Per-node DSH gateway used only by the mounted Stage 6/8 drill.
{
    auto_https off
    admin off
    servers :9443 {
        protocols h1 h2
    }
}

# Internal, unauthenticated adapter used by the real Node RouteIngress. It
# stays in the DSH container network namespace and adds only non-secret drill
# identity headers so the mounted runner can prove A/B isolation and cookie
# sanitization against the real DSH process.
:3081 {
    reverse_proxy 127.0.0.1:3080 {
        header_up Host {$DSH_PUBLIC_HOST}
        header_up X-Forwarded-Proto http
        header_down X-Drill-Node {$DSH_DRILL_NODE}
        header_down Set-Cookie "drill_node={$DSH_DRILL_NODE}; Domain=.dsh-orbit.test; Path=/; HttpOnly"
    }
}

https://:9443 {
    tls /etc/caddy/tls/tls.crt /etc/caddy/tls/tls.key

    basic_auth {
        operator $2a$14$bsm0UM/r9TDI0b70bwS.LuMKOadTMk3N1TSjSmlDtbpzmByVxEFqG
    }

    reverse_proxy 127.0.0.1:3080 {
        header_up Host {$DSH_PUBLIC_HOST}
        header_up X-Forwarded-Proto https
        header_up X-DSH-Orbit-Authenticated-Proxy {$DSH_PROXY_AUTH}
    }
}
