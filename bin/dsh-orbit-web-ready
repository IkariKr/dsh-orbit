#!/bin/sh
# DSH web readiness probe shared by the container start script and the Compose
# healthchecks.
#
# Readiness cannot be an authenticated probe: once native BrowserAuth owns the
# index, the /?token= exchange is the only admission path and every other
# request is answered 401. A probe that requires an HTTP 2xx therefore never
# observes readiness on that generation, even though the web server is serving
# normally. Readiness here means "the server answered HTTP at all", which a
# public generation (200) and an authenticated one (401) both satisfy — the
# probe stays correct for either without asking which DSH generation is
# installed.
#
# Usage: dsh-orbit-web-ready [url]   (default http://127.0.0.1:3080)
set -eu

probe_url="${1:-http://127.0.0.1:3080}"

# --noproxy keeps the loopback probe on the loopback interface even when the
# container environment exports proxy variables.
status="$(
  curl --silent --output /dev/null --write-out '%{http_code}' \
    --max-time 5 --noproxy '*' "$probe_url" 2>/dev/null || true
)"

case "$status" in
  ""|000*) exit 1 ;;
  *) exit 0 ;;
esac
