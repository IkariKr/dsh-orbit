{
  "name": "dsh-orbit",
  "version": "0.4.0-rc.2",
  "private": true,
  "description": "Secure self-hosting and fleet layer for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/plugin/index.mjs",
    "./client": "./src/plugin/client.mjs",
    "./qr-svg": "./src/plugin/qr-svg.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "orbit"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-public-tree.mjs && node --test",
    "smoke:settings": "node scripts/smoke-settings.mjs",
    "smoke:session": "node scripts/smoke-session-resume.mjs",
    "smoke:terminal": "node scripts/smoke-terminal.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "stage7:drill": "node scripts/registry-stage7-drill.mjs",
    "report:compatibility": "node scripts/report-compatibility.mjs",
    "upgrade": "node bin/dsh-orbit-upgrade.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
